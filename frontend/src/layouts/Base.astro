---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import PageSkeleton from '../components/PageSkeleton.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/frontend/icon-512.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'STACY',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  description,
  url: 'https://www.stacyprogram.online/frontend',
  downloadUrl: 'https://marketplace.visualstudio.com/items?itemName=STACY.stacy-extension',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/frontend/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/frontend/icon-512.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="STACY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#14110e" />
    <meta name="color-scheme" content="dark light" />

    <script is:inline>
      // Marca JS disponible para que el esqueleto solo se pinte con JS.
      document.documentElement.classList.add('has-js');
    </script>

    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar el parpadeo.
      (() => {
        const stored = localStorage.getItem('stacy-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'light' ? '#faf7f2' : '#14110e';
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <PageSkeleton />
    <slot />
    <script>
      // Transicion de entrada: el esqueleto se retira cuando el documento
      // esta listo. Si no hay JS, el esqueleto nunca se pinta (oculto por CSS
      // hasta que el script lo activa) y el contenido se ve directamente.
      const boot = document.querySelector<HTMLElement>('[data-boot-skeleton]');
      const root = document.documentElement;

      // Minimo visible: aunque la pagina cargue en ~350 ms, el esqueleto
      // se muestra al menos 450 ms para que la transicion se lea.
      const bootStart = performance.now();
      const BOOT_MIN = 450;
      let revealed = false;

      const reveal = () => {
        if (revealed) return;
        revealed = true;
        const wait = Math.max(0, BOOT_MIN - (performance.now() - bootStart));
        window.setTimeout(() => {
          root.classList.add('is-booted');
          boot?.setAttribute('hidden', '');
        }, wait);
      };

      if (document.readyState === 'complete') {
        reveal();
      } else {
        window.addEventListener('load', reveal, { once: true });
        // Fuentes web: cuando están listas, el texto real no cambia de ancho.
        document.fonts?.ready.then(reveal).catch(() => {});
        // Red de seguridad: si la carga se eterniza, el contenido se muestra.
        setTimeout(reveal, 2500);
      }
    </script>
  </body>
</html>
