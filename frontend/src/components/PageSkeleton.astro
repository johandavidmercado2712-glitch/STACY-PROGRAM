---
// Esqueleto de carga: replica la composicion de la cabecera y del hero para
// que la transicion al contenido real no de un salto de maquetacion.
---

<div class="boot" data-boot-skeleton aria-hidden="true">
  <header class="boot__header">
    <div class="wrap boot__header-inner">
      <span class="boot__brand"></span>
      <div class="boot__nav">
        <span class="boot__link"></span>
        <span class="boot__link"></span>
        <span class="boot__link"></span>
      </div>
    </div>
  </header>

  <div class="wrap boot__hero">
    <div class="boot__hero-copy">
      <span class="boot__title"></span>
      <span class="boot__title boot__title--short"></span>
      <span class="boot__line"></span>
      <span class="boot__line boot__line--short"></span>
      <div class="boot__actions">
        <span class="boot__btn"></span>
        <span class="boot__btn boot__btn--ghost"></span>
      </div>
    </div>
    <div class="boot__panel">
      <span class="boot__bar"></span>
      <span class="boot__row"></span>
      <span class="boot__row boot__row--short"></span>
      <span class="boot__row"></span>
      <span class="boot__row boot__row--short"></span>
      <span class="boot__row"></span>
    </div>
  </div>
</div>